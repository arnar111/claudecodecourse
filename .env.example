# Afritaðu þessa skrá í .env og settu inn raunverulegar gildi.
# Lykillinn fæst frá https://console.anthropic.com/

ANTHROPIC_API_KEY=

# Netlify Identity — slóð á Netlify síðuna þína (þar sem Identity er virkjað).
# Krafist í local dev til að innskráning virki. Dæmi:
#   VITE_NETLIFY_SITE_URL=https://your-site.netlify.app
# Í Netlify production er þetta sjálfkrafa rétt sett.
VITE_NETLIFY_SITE_URL=
