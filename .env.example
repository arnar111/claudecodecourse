# Afritaðu þessa skrá í .env og settu inn raunverulegar gildi.
# Lykillinn fæst frá https://console.anthropic.com/

ANTHROPIC_API_KEY=

# Netlify Identity — slóð á Netlify síðuna (þar sem Identity er virkjað).
# Krafist í local dev til að innskráning virki.
# Í Netlify production er þetta sjálfkrafa rétt sett.
VITE_NETLIFY_SITE_URL=https://claudenamskeid.netlify.app
